// SnagPack data model.
// Postgres (Vercel/Neon). Uses Neon's Prisma-optimized pooled URL at runtime and
// the non-pooling direct URL for migrations/db push (the standard Neon+Prisma+Vercel
// setup). Both vars are injected by the Neon Marketplace integration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// A product we watch across a retailer. Adding a source = inserting a row (config, not code).
model Product {
  id        String   @id @default(cuid())
  name      String
  retailer  String // adapter id: "bestbuy" | "generic" | "target" | "walmart" | ...
  url       String // product page or API-resolvable URL
  sku       String? // retailer SKU/DPCI when known (required for API adapters)
  category  String   @default("OTHER") // POKEMON | BASEBALL | FOOTBALL | BASKETBALL | OTHER
  msrp      Float? // what we pay at retail
  marketPrice Float? // expected resale (comps) — feeds the margin decision

  // Generic-scraper signals: substrings that indicate stock state on the page.
  inStockMatch    String? // e.g. "Add to cart"
  outOfStockMatch String? // e.g. "Out of stock"

  active        Boolean  @default(true)
  lastInStock   Boolean  @default(false)
  lastPrice     Float?
  lastCheckedAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events    RestockEvent[]
  purchases Purchase[]

  @@index([active])
}

// Fired the moment a product transitions out-of-stock -> in-stock.
model RestockEvent {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  detectedAt DateTime @default(now())
  price      Float?
  // ALERTED | CART_BUILT | PURCHASED | SKIPPED_MARGIN | FAILED
  action     String   @default("ALERTED")
  note       String?

  @@index([detectedAt])
}

// Inventory + P&L ledger. One row per buy; tracked through to sold.
model Purchase {
  id          String   @id @default(cuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name        String
  retailer    String
  qty         Int      @default(1)
  unitCost    Float
  purchasedAt DateTime @default(now())
  orderRef    String?
  // ORDERED | IN_TRANSIT | RECEIVED | LISTED | SOLD | RETURNED
  status      String   @default("ORDERED")
  listPrice   Float?
  soldPrice   Float?
  fees        Float?
  soldAt      DateTime?
  note        String?

  @@index([status])
}

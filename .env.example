# Database (SQLite for local dev; swap for a Postgres URL on Vercel)
DATABASE_URL="file:./dev.db"

# Alerts — where restock notifications get pushed.
# Create a Discord channel webhook and paste the URL here. Leave blank to log to console.
DISCORD_WEBHOOK_URL=""

# Best Buy has an official product API (the cleanest, ToS-safe stock source).
# Get a key at https://developer.bestbuy.com/  (leave blank to skip Best Buy checks)
BESTBUY_API_KEY=""

# Shared secret to protect the /api/monitor endpoint when a cron calls it.
MONITOR_SECRET="change-me"

# Checkout mode: "assisted" (build a cart + alert, you tap buy) or "auto" (pluggable, off by default)
CHECKOUT_MODE="assisted"
